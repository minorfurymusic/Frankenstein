<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Contador de passos real (.claude/rules/activity.md: "Foreground
         service no Android. A contagem NÃO pode parar com a tela
         bloqueada"). ACTIVITY_RECOGNITION é obrigatória desde o Android 10
         (API 29) pra ler TYPE_STEP_COUNTER/TYPE_STEP_DETECTOR — permissão
         de risco, pedida em runtime (MainActivity.kt). FOREGROUND_SERVICE_HEALTH
         é a permissão normal (concedida automaticamente) exigida desde o
         Android 14 (API 34) pra declarar foregroundServiceType="health".
         POST_NOTIFICATIONS é exigida desde o Android 13 (API 33) pra
         qualquer notificação, incluindo a do foreground service — sem ela
         o serviço ainda roda, só a notificação não aparece (comportamento
         documentado do Android, não bug daqui). -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lembretes (Reminders.kt): reagendar depois de reiniciar o celular. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Leitor de código de barras (flutter_zxing → camera_android_camerax).
         A câmera é pedida em runtime só quando a pessoa abre o leitor. O
         plugin de câmera também declara microfone e armazenamento (para
         gravar vídeo); o app não grava vídeo, então essas saem do APK. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Corrida/caminhada com GPS (ADR-9 revisão 1, RunRecorderService.kt):
         localização precisa só enquanto a gravação está ligada, por serviço
         em primeiro plano iniciado pela pessoa. Não pede localização em
         segundo plano (ACCESS_BACKGROUND_LOCATION). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <!-- Health Connect (ADR-4a, HealthConnectBridge.kt): só LEITURA de sono e
         frequência cardíaca que a pulseira/relógio gravou lá. Pedidas em
         runtime, só quando a pessoa toca em "Conectar" em Conta › Dispositivos. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <!-- A biblioteca do Health Connect pede API 26; o app segue instalando
         da API 24 e só usa o Health Connect da API 28 em diante (onde ele
         existe). -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client"/>
    <!-- required="false": aparelho sem sensor de passos ainda instala o
         app, só não conta passos — degradação gradual, não trava nada. -->
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false"/>

    <!-- allowBackup=false: o backup automático do Android mandaria os bancos
         (dados de saúde) e a chave da IA para a nuvem do Google sem ação da
         pessoa (.claude/rules/00-inviolaveis.md, .claude/rules/brain.md).
         Levar os dados é pela exportação, sempre por escolha dela. -->
    <application
        android:label="RLT"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!-- image_picker_android declara um serviço-marcador que pede ao
             Google Play Services o seletor de fotos "retroportado". Sem
             serviços do Google (CLAUDE.md, regra 6): sai do APK; em Android
             antigo o seletor cai no ACTION_OPEN_DOCUMENT padrão. -->
        <service android:name="com.google.android.gms.metadata.ModuleDependencies" tools:node="remove"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect (Android 13 ou anterior) abre o app para mostrar
                 como os dados são usados: o app abre em Conta › Privacidade. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <!-- Mesmo papel no Android 14+. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Lembretes locais: alarme dispara a notificação; boot reagenda. -->
        <receiver android:name=".ReminderReceiver" android:exported="false"/>
        <receiver android:name=".ReminderBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".RunRecorderService"
            android:exported="false"
            android:foregroundServiceType="location"/>
        <service
            android:name=".StepCounterService"
            android:exported="false"
            android:foregroundServiceType="health"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Saber se o Health Connect está instalado (Android 9 a 13). -->
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>
</manifest>
